{
  "name": "@owdproject/kit-nuxt-ui",
  "version": "4.0.0-alpha.3",
  "description": "Nuxt UI for OWD themes: dialogs (always) and optional DesktopExplorer* UI (requires @owdproject/module-nuxt-fs; use { explorer: false } for dialogs only).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "development": "./src/module.ts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./runtime/dialogs/createDesktopDialogs": {
      "types": "./src/runtime/dialogs/createDesktopDialogs.ts",
      "import": "./src/runtime/dialogs/createDesktopDialogs.ts"
    },
    "./runtime/dialogs/*": {
      "types": "./src/runtime/dialogs/*",
      "import": "./src/runtime/dialogs/*"
    },
    "./runtime/components/*": {
      "types": "./src/runtime/components/*",
      "import": "./src/runtime/components/*"
    },
    "./kit/registerTailwindPath": {
      "types": "./src/kit/registerTailwindPath.ts",
      "import": "./src/kit/registerTailwindPath.ts"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "src/runtime",
    "src/kit"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare",
    "dev:prepare": "nuxt-module-build build --stub",
    "build:module": "nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.4",
    "@nuxt/ui": "^2.21.0",
    "defu": "^6.1.4",
    "vue3-selecto": "^1.12.3",
    "@owdproject/nuxt": "^4.0.0-alpha.3"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.4",
    "@owdproject/core": "^4.0.0-alpha.3",
    "@owdproject/module-nuxt-fs": "^4.0.0-alpha.3",
    "nuxt": "^4.4.4",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@owdproject/core": "^4.0.0-alpha.3",
    "@owdproject/module-nuxt-fs": "^4.0.0-alpha.3",
    "@owdproject/nuxt": "^4.0.0-alpha.3"
  },
  "peerDependenciesMeta": {
    "@owdproject/module-nuxt-fs": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
